<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: stesse esclusioni per backup cloud e trasferimento tra dispositivi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="settings.json" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings.json" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
